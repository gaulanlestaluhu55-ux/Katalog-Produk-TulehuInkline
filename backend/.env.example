# Contoh env backend Tulehu Inkline — copy jadi backend/.env lalu isi nilainya.
# JANGAN commit file .env (sudah di-gitignore). Nilai produksi tinggal di Vercel dashboard.

# Supabase Project Settings → API → Project URL
SUPABASE_URL=

# Supabase Project Settings → API → service_role key (BUKAN anon key, rahasia!)
SUPABASE_SERVICE_ROLE_KEY=

# Token login admin, samain dengan yang dipakai frontend (localStorage adminToken)
# dan dengan ADMIN_TOKEN di Vercel dashboard
ADMIN_TOKEN=

# Opsional, dukung multi-origin koma. Default kode: https://katalog.tulehuinkline.my.id
# Tambah http://localhost:8000 biar bisa tes frontend dari laptop
CORS_ORIGIN=https://katalog.tulehuinkline.my.id,http://localhost:8000

# Hanya untuk scripts/migrate-from-gas.js (boleh kosong kalau tidak migrasi)
OLD_GAS_URL=
